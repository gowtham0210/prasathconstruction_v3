# Enquiries are emailed with Web3Forms (free) by default. The access key below is public by design.
# Leave VITE_FORM_ENDPOINT empty to use Web3Forms; set it (for example "/api/enquiry", served by `npm run server`) to use another service.
VITE_WEB3FORMS_KEY=1f15a9d2-c792-42d7-bdeb-5b8a73e8f36c
VITE_FORM_ENDPOINT=

# Company details (all optional — empty values are hidden on the site)
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_ADDRESS=
VITE_SERVICE_AREAS=
# WhatsApp number, digits only with country code, e.g. 919876543210
VITE_WHATSAPP_NUMBER=
# Public URL of the deployed site (used for canonical/OG/sitemap)
VITE_SITE_URL=https://example.com
